{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "dockerfile"],
  "minimumReleaseAge": "2 days",
  "automerge": false,
  "vulnerabilityAlerts": {
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Disable regular npm updates; npm security fixes are severity-filtered below",
      "matchJsonata": ["$exists(updateType) and ($not($exists(isVulnerabilityAlert)) or isVulnerabilityAlert = false)"],
      "enabled": false,
      "matchManagers": ["npm"]
    },
    {
      "description": "Allow npm vulnerability fixes only when GitHub reports HIGH or CRITICAL severity",
      "matchJsonata": [
        "isVulnerabilityAlert and ($not($exists(vulnerabilitySeverity)) or (vulnerabilitySeverity != 'HIGH' and vulnerabilitySeverity != 'CRITICAL'))"
      ],
      "enabled": false,
      "matchManagers": ["npm"]
    },
    {
      "description": "Offer every supported Dockerfile version and image digest update as a manually merged PR",
      "matchManagers": ["dockerfile"],
      "enabled": true,
      "pinDigests": true,
      "automerge": false
    }
  ]
}
