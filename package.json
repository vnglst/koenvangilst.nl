{
  "name": "koenvangilst.nl",
  "version": "9.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "sync:photos": "node scripts/sync-photos.mjs",
    "fetch:lobith": "node scripts/fetch-lobith-data.mjs",
    "build": "vite build",
    "start": "srvx --prod --entry dist/server/server.js --static ../client",
    "preview": "npm run start -- --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:docker": "node scripts/run-e2e-docker.mjs",
    "test:photos:docker": "docker compose --env-file .env.zipline run --rm zipline-sync /app/sync.sh",
    "type-check": "oxlint --type-aware --type-check",
    "lint": "oxlint",
    "format": "prettier --write . && oxlint --fix",
    "check": "prettier --check .",
    "knip": "knip",
    "update-deps": "node scripts/update-deps.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,md,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    }
  },
  "dependencies": {
    "@mdx-js/react": "3.1.1",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.3",
    "d3": "7.9.0",
    "d3-hexbin": "0.2.2",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3": "7.4.3",
    "@types/d3-hexbin": "0.2.5",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "husky": "9.1.7",
    "knip": "6.41.0",
    "lint-staged": "17.6.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-code-titles": "1.2.1",
    "rehype-prism-plus": "2.0.2",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "unist-util-visit": "5.1.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
